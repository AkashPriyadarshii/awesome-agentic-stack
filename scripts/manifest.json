      "winget": null,
      "platform_skip": ["win32"],
      "description": "Terminal multiplexer for parallel agent splits",
      "depends_on": [],
      "fail_advice": [
        "brew install tmux (macOS) / sudo apt install tmux (Linux)"
      ]
    },
