{
  "cli_binaries": [
    {
      "name": "ripgrep",
      "binary": "rg",
      "essential": true,
      "brew": "ripgrep",
      "apt": "ripgrep",
      "winget": "BurntSushi.ripgrep",
      "description": "Ultra-fast text search in files",
      "depends_on": [],
      "fail_advice": [
        "Download from https://github.com/BurntSushi/ripgrep/releases",
        "scoop install ripgrep"
      ]
    },
    {
      "name": "gitleaks",
      "binary": "gitleaks",
      "essential": true,
      "brew": "gitleaks",
      "winget": null,
      "go_install": "github.com/gitleaks/gitleaks/v8@latest",
      "zip_url_windows": "https://github.com/gitleaks/gitleaks/releases/latest/download/gitleaks_windows_x64.zip",
      "zip_url_darwin": "https://github.com/gitleaks/gitleaks/releases/latest/download/gitleaks_darwin_x64.tar.gz",
      "zip_url_linux": "https://github.com/gitleaks/gitleaks/releases/latest/download/gitleaks_linux_x64.tar.gz",
      "description": "Scans directory for credentials/secrets before push",
      "depends_on": ["go"],
      "fail_advice": [
        "go install github.com/gitleaks/gitleaks/v8@latest",
        "Download from https://github.com/gitleaks/gitleaks/releases"
      ]
    },
    {
      "name": "trufflehog",
      "binary": "trufflehog",
      "essential": false,
      "brew": "trufflehog",
      "winget": null,
      "pip": "trufflehog",
      "go_install": "github.com/trufflesecurity/trufflehog/v3@latest",
      "description": "Scans entire git history for leaked credentials",
      "depends_on": [],
      "fail_advice": [
        "pip install trufflehog",
        "go install github.com/trufflesecurity/trufflehog/v3@latest",
        "Download from https://github.com/trufflesecurity/trufflehog/releases"
      ]
    },
    {
      "name": "tmux",
      "binary": "tmux",
      "essential": true,
      "brew": "tmux",
